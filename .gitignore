# Large data files
*.csv.gz
*.csv.zip
data/**/*.csv
!data/README.md
!data/subdataset_1000/*.csv
!data/example_100/*.csv

# Output files - exclude everything except directory structure
output/**
!output/
!output/**/.gitkeep

# Temporary files
*.tmp
*.temp
temp/
cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv
venv/
.ipynb_checkpoints/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Credentials and secrets
*.key
*.pem
credentials.json
secrets.yaml
config.local.yaml

# Large model files
*.pkl
*.pickle
*.h5
*.hdf5
*.parquet
*.joblib

# Log files
*.log
logs/

# Backup files
*.bak
backup/
*.backup

# Keep important files
!README.md
!requirements.txt
!setup.py
!docs/**/*.md
!pipeline_modules/**/*.py
!utils/**/*.py
!notebooks/**/*.ipynb
!config/*.yaml
!main/*.py
# Data directories
data_1000/
data_500/
data_5000/
data_10000/
data/*.csv

# Performance optimization testing
performance_optimization/

# Cache files
data/.row_counts_cache.json
**/.row_counts_cache.json
*.cache.json

# Extracted patient data - exclude actual data but keep directory structure
extracted_patient_data/*
!extracted_patient_data/.gitkeep

# Predictive modeling results - exclude experiments but keep structure
predictive_modeling/modeling_results/experiments/*
!predictive_modeling/modeling_results/experiments/.gitkeep
predictive_modeling/modeling_results/trained_models/**/*.pkl
predictive_modeling/modeling_results/trained_models/**/*.joblib
predictive_modeling/modeling_results/features/*.csv
predictive_modeling/modeling_results/logs/*.log
predictive_modeling/modeling_results/visualizations/**/*.png
predictive_modeling/modeling_results/visualizations/**/*.jpg
predictive_modeling/modeling_results/reports/*.html

